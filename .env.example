# Copy only the provider you use into your own environment or the local
# ~/.config/sansheng-stylebook/.env file. Never commit that file or a real key.
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# ARK_API_KEY=replace-me
# DASHSCOPE_API_KEY=replace-me
# GEMINI_API_KEY=replace-me
# OPENROUTER_API_KEY=replace-me

# Optional private defaults and style contracts, stored outside this repository.
# STYLEBOOK_PROFILE=/absolute/path/to/your/private/profile
